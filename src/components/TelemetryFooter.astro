---
import { profile } from '../data/profile';

interface Props {
  currentFocus?: string;
  emailAddress?: string;
}

const {
  currentFocus = "Distributed data systems & LLM orchestration",
  emailAddress = profile.email,
} = Astro.props;

const currentYear = new Date().getFullYear();
const showEmail = Boolean(emailAddress && !emailAddress.includes("example.com"));
---

<footer class="telemetry-footer" id="contact">
  <div class="container footer-inner">
    <div class="telemetry-grid">
      <div class="telemetry-block">
        <span class="telemetry-label font-mono">Location & Local Time</span>
        <div class="telemetry-value font-mono">
          <span class="location-tag">Jakarta, ID</span>
          <span class="delimiter" aria-hidden="true">·</span>
          <time id="telemetry-clock" datetime="" class="clock-display">--:--:-- WIB</time>
        </div>
      </div>

      <div class="telemetry-block">
        <span class="telemetry-label font-mono">Current Focus</span>
        <div class="telemetry-value">
          <span class="focus-text">{currentFocus}</span>
        </div>
      </div>

      {showEmail && (
        <div class="telemetry-block">
          <span class="telemetry-label font-mono">Direct Communication</span>
          <div class="telemetry-value font-mono">
            <a href={`mailto:${emailAddress}`} class="email-link" aria-label={`Send email to ${emailAddress}`}>
              {emailAddress}
            </a>
          </div>
        </div>
      )}
    </div>

    <div class="footer-bottom">
      <p class="copyright text-muted font-mono">
        &copy; {currentYear} Systems Engineering Portfolio. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<script>
  function initClock(): void {
    const clockEl = document.getElementById('telemetry-clock');
    if (!clockEl) return;

    const targetEl: HTMLElement = clockEl;

    const formatter = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Asia/Jakarta',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false,
    });

    function updateTime(): void {
      try {
        const now = new Date();
        const timeString = formatter.format(now);
        targetEl.textContent = `${timeString} WIB`;
        targetEl.setAttribute('datetime', now.toISOString());
      } catch {
        targetEl.textContent = 'UTC+7';
      }
    }

    updateTime();
    setInterval(updateTime, 1000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initClock);
  } else {
    initClock();
  }
</script>

<style>
  .telemetry-footer {
    width: 100%;
    margin-top: var(--space-16);
    border-top: 1px solid var(--border-subtle);
    background-color: var(--bg-surface);
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .telemetry-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .telemetry-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-8);
    }
  }

  .telemetry-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .telemetry-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .telemetry-value {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .delimiter {
    color: var(--border-active);
  }

  .location-tag {
    color: var(--text-primary);
  }

  .clock-display {
    color: var(--text-accent);
    font-variant-numeric: tabular-nums;
  }

  .focus-text {
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  .email-link {
    color: var(--text-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--transition-fast);
  }

  .email-link:hover {
    color: var(--text-primary);
  }

  .email-link:focus-visible {
    outline: 2px solid var(--text-accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-subtle);
  }

  .copyright {
    font-size: var(--text-xs);
    margin: 0;
  }
</style>
