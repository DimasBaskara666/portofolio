---
interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  pageType?: 'website' | 'article' | 'profile';
  ogImage?: string;
  publishedTime?: string;
  tags?: string[];
}

const {
  title,
  description,
  canonicalUrl,
  pageType = 'website',
  ogImage = '/og-image.png',
  publishedTime,
  tags = [],
} = Astro.props;

// Detect whether the configured site URL is a local or placeholder domain
const isPlaceholderSite =
  !Astro.site ||
  Astro.site.hostname === 'portfolio.local' ||
  Astro.site.hostname === 'localhost' ||
  Astro.site.hostname === '127.0.0.1';

// Only output a canonical URL if explicitly passed or if a genuine production domain is configured
let computedCanonical: string | undefined = undefined;
if (canonicalUrl && !canonicalUrl.includes('portfolio.local')) {
  computedCanonical = canonicalUrl;
} else if (!isPlaceholderSite && Astro.site) {
  computedCanonical = new URL(Astro.url.pathname, Astro.site).href;
}

// Build JSON-LD structured data only where it accurately describes the page content
let structuredData: Record<string, unknown> | null = null;

if (pageType === 'profile') {
  structuredData = {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    headline: title,
    description: description,
    ...(computedCanonical ? { url: computedCanonical } : {}),
    mainEntity: {
      '@type': 'Person',
      name: 'Dimas',
      description:
        'Informatics graduate specializing in data pipelines, backend architecture, and applied machine learning.',
      ...(computedCanonical ? { url: computedCanonical } : {}),
      knowsAbout: [
        'Data Engineering',
        'Software Engineering',
        'Machine Learning',
        'Natural Language Processing',
        'Distributed Systems',
        'Python',
        'SQL',
      ],
    },
  };
} else if (pageType === 'article') {
  structuredData = {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: title,
    description: description,
    ...(computedCanonical ? { url: computedCanonical } : {}),
    ...(publishedTime ? { datePublished: publishedTime } : {}),
    author: {
      '@type': 'Person',
      name: 'Dimas',
    },
    ...(tags.length > 0 ? { keywords: tags.join(', ') } : {}),
  };
}

const safeJsonLd = structuredData
  ? JSON.stringify(structuredData).replace(/<\/script/gi, '<\\/script')
  : null;
---

<!-- Authoritative Primary Metadata -->
<title>{title}</title>
<meta name="description" content={description} />

{computedCanonical && <link rel="canonical" href={computedCanonical} />}

<!-- Open Graph Metadata -->
<meta property="og:type" content={pageType === 'article' ? 'article' : 'website'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="Systems Engineering Portfolio" />
{computedCanonical && <meta property="og:url" content={computedCanonical} />}
{ogImage && <meta property="og:image" content={ogImage} />}

{pageType === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{pageType === 'article' && <meta property="article:author" content="Dimas" />}
{pageType === 'article' &&
  tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter / X Card Metadata -->
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

<!-- Structured Data (JSON-LD) -->
{safeJsonLd && <script type="application/ld+json" set:html={safeJsonLd} />}
