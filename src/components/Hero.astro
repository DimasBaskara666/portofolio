---
import fs from 'node:fs';
import path from 'node:path';
import { profile } from '../data/profile';

interface Props {
  name?: string;
  cvUrl?: string;
}

const {
  name = "Dimas",
  cvUrl = profile.cvUrl,
} = Astro.props;

const imageRelPath = '/images/profile.webp';
const imageDiskPath = path.join(process.cwd(), 'public', 'images', 'profile.webp');
const photoExists = fs.existsSync(imageDiskPath);
---

<section class="hero-section" aria-labelledby="hero-title">
  <div class="hero-grid">
    <div class="hero-copy">
      <p class="hero-eyebrow font-mono text-secondary">Informatics graduate · Bandung, ID</p>
      <h1 id="hero-title" class="hero-heading font-serif">
        {name}
      </h1>
      <p class="hero-subline text-secondary">
        Data Engineer focused on reproducible data pipelines, automated batch processing, and database integrity.
      </p>
      <p class="hero-body text-secondary">
        Building automated ingestion workflows and analytical storage systems using <code>Python</code>, <code>SQL</code>, <code>PostgreSQL</code>, <code>DuckDB</code>, and <code>GitHub Actions</code>. Emphasizing clean data contracts, deterministic transformations, and verified test coverage.
      </p>

      <div class="hero-actions">
        <a href="#work" class="btn btn-primary font-mono">
          <span>View selected work</span>
          <span class="btn-arrow" aria-hidden="true">↓</span>
        </a>
        <a href="/about/" class="btn btn-secondary font-mono">
          <span>About and background</span>
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
        {cvUrl && (
          <a
            href={cvUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost font-mono"
            aria-label="CV: View Curriculum Vitae (opens in new tab)"
          >
            <span>CV</span>
            <span class="btn-arrow" aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </div>

    <div class="hero-media">
      {photoExists ? (
        <figure
          class="profile-frame"
          id="hero-profile-frame"
          tabindex="0"
          role="button"
          aria-pressed="false"
          aria-label={`Portrait of ${name}. Activate to toggle technical schematic overlay.`}
        >
          <img
            src={imageRelPath}
            alt={`Portrait of ${name}`}
            width="480"
            height="600"
            loading="eager"
            fetchpriority="high"
            class="profile-image"
          />

          <!-- Schematic Registration Overlay -->
          <div class="schematic-layer" aria-hidden="true">
            <!-- Corner registration marks -->
            <span class="reg-corner reg-tl"></span>
            <span class="reg-corner reg-tr"></span>
            <span class="reg-corner reg-bl"></span>
            <span class="reg-corner reg-br"></span>

            <!-- Dynamic tracking crosshair -->
            <div class="reg-reticle"></div>

            <!-- Header technical indicators -->
            <div class="reg-bar reg-bar-top font-mono">
              <span class="reg-tag">REG // FRAME</span>
              <span class="reg-dim">4:5 · 480×600</span>
            </div>

            <!-- Footer coordinate display -->
            <div class="reg-bar reg-bar-bottom font-mono">
              <span class="reg-coord" id="coord-display">X: 0 Y: 0</span>
              <span class="reg-status">TRACKING</span>
            </div>
          </div>
        </figure>
      ) : (
        <div class="profile-frame profile-frame-pending" aria-label="Profile photo pending delivery">
          <div class="pending-inner font-mono text-xs text-muted">
            <span class="pending-badge">Profile portrait</span>
            <span class="pending-path">public/images/profile.webp</span>
            <span class="pending-note">Pending user asset delivery</span>
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<script>
  function initSchematicRegistration(): void {
    const frame = document.getElementById('hero-profile-frame');
    if (!frame) return;
    if (frame.dataset.bound === 'true') return;
    frame.dataset.bound = 'true';

    const coordEl = frame.querySelector<HTMLElement>('#coord-display');
    const statusEl = frame.querySelector<HTMLElement>('.reg-status');

    let isLocked = false;

    function updateCoords(x: number, y: number): void {
      const roundedX = Math.round(x);
      const roundedY = Math.round(y);
      frame?.style.setProperty('--target-x', `${roundedX}px`);
      frame?.style.setProperty('--target-y', `${roundedY}px`);
      if (coordEl) {
        coordEl.textContent = `X: ${roundedX} Y: ${roundedY}`;
      }
    }

    function handleMouseMove(e: MouseEvent): void {
      if (isLocked) return;
      const rect = frame?.getBoundingClientRect();
      if (!rect) return;
      const x = Math.max(0, Math.min(rect.width, e.clientX - rect.left));
      const y = Math.max(0, Math.min(rect.height, e.clientY - rect.top));
      updateCoords(x, y);
    }

    function toggleLocked(): void {
      isLocked = !isLocked;
      frame?.classList.toggle('is-locked', isLocked);
      frame?.setAttribute('aria-pressed', isLocked ? 'true' : 'false');
      if (statusEl) {
        statusEl.textContent = isLocked ? 'LOCKED' : 'TRACKING';
      }
      if (isLocked) {
        const rect = frame?.getBoundingClientRect();
        if (rect) {
          updateCoords(rect.width / 2, rect.height / 2);
        }
      }
    }

    frame.addEventListener('mousemove', handleMouseMove, { passive: true });

    frame.addEventListener('click', () => {
      toggleLocked();
    });

    frame.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggleLocked();
      }
    });

    frame.addEventListener('mouseenter', () => {
      if (!isLocked) {
        const rect = frame?.getBoundingClientRect();
        if (rect) {
          updateCoords(rect.width / 2, rect.height / 2);
        }
      }
    });
  }

  document.addEventListener('astro:page-load', initSchematicRegistration);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSchematicRegistration);
  } else {
    initSchematicRegistration();
  }
</script>

<style>
  .hero-section {
    padding-top: var(--space-8);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--border-subtle);
  }

  @media (min-width: 768px) {
    .hero-section {
      padding-top: var(--space-12);
      padding-bottom: var(--space-16);
    }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: start;
    min-width: 0;
  }

  @media (min-width: 768px) {
    .hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--space-10);
      align-items: center;
    }
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 38rem;
    min-width: 0;
  }

  .hero-eyebrow {
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--text-secondary);
  }

  .hero-heading {
    font-size: 2.75rem;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin: 0;
  }

  @media (min-width: 768px) {
    .hero-heading {
      font-size: 3.5rem;
    }
  }

  .hero-subline {
    font-size: var(--text-lg);
    line-height: 1.4;
    color: var(--text-primary);
    font-weight: 500;
  }

  .hero-body {
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .hero-body code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 0.15rem 0.35rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.65rem 1.15rem;
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background-color var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
  }

  .btn-primary {
    background-color: var(--accent-terracotta);
    color: #ffffff;
    border: 1px solid var(--accent-terracotta);
    font-weight: 500;
  }

  .btn-primary:hover {
    background-color: #cb6246;
    border-color: #cb6246;
  }

  .btn-primary:focus-visible {
    outline: 2px solid var(--accent-terracotta);
    outline-offset: 2px;
  }

  .btn-secondary {
    background-color: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
    font-weight: 500;
  }

  .btn-secondary:hover {
    background-color: var(--bg-surface-hover);
    border-color: var(--border-active);
  }

  .btn-secondary:focus-visible {
    outline: 2px solid var(--accent-terracotta);
    outline-offset: 2px;
  }

  .btn-ghost {
    background-color: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
  }

  .btn-ghost:hover {
    color: var(--text-primary);
    background-color: var(--bg-surface);
    border-color: var(--border-active);
  }

  .btn-ghost:focus-visible {
    outline: 2px solid var(--accent-terracotta);
    outline-offset: 2px;
  }

  .btn-arrow {
    font-weight: 600;
  }

  /* Profile Media Frame */
  .hero-media {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  @media (min-width: 768px) {
    .hero-media {
      justify-content: flex-end;
    }
  }

  .profile-frame {
    position: relative;
    width: 100%;
    max-width: 340px;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    margin: 0;
    cursor: pointer;
    outline: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .profile-frame:hover,
  .profile-frame.is-locked {
    border-color: var(--accent-terracotta);
  }

  .profile-frame:focus-visible {
    outline: 2px solid var(--accent-terracotta);
    outline-offset: 3px;
  }

  .profile-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    user-select: none;
  }

  /* Schematic Registration Layer */
  .schematic-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--transition-fast);
  }

  .profile-frame:hover .schematic-layer,
  .profile-frame:focus-visible .schematic-layer,
  .profile-frame.is-locked .schematic-layer {
    opacity: 1;
  }

  /* Corner brackets */
  .reg-corner {
    position: absolute;
    width: 16px;
    height: 16px;
    border-color: var(--accent-terracotta);
    border-style: solid;
    pointer-events: none;
    transition: border-color var(--transition-fast);
  }

  .reg-tl {
    top: 8px;
    left: 8px;
    border-width: 2px 0 0 2px;
  }

  .reg-tr {
    top: 8px;
    right: 8px;
    border-width: 2px 2px 0 0;
  }

  .reg-bl {
    bottom: 8px;
    left: 8px;
    border-width: 0 0 2px 2px;
  }

  .reg-br {
    bottom: 8px;
    right: 8px;
    border-width: 0 2px 2px 0;
  }

  /* Reticle tracking indicator */
  .reg-reticle {
    position: absolute;
    top: var(--target-y, 50%);
    left: var(--target-x, 50%);
    width: 32px;
    height: 32px;
    transform: translate(-50%, -50%);
    border: 1px solid var(--accent-terracotta);
    border-radius: 50%;
    pointer-events: none;
    opacity: 0.9;
    transition: opacity var(--transition-fast);
  }

  .reg-reticle::before,
  .reg-reticle::after {
    content: '';
    position: absolute;
    background-color: var(--accent-terracotta);
  }

  .reg-reticle::before {
    top: 50%;
    left: -8px;
    right: -8px;
    height: 1px;
    transform: translateY(-50%);
  }

  .reg-reticle::after {
    left: 50%;
    top: -8px;
    bottom: -8px;
    width: 1px;
    transform: translateX(-50%);
  }

  /* Top & bottom bars */
  .reg-bar {
    position: absolute;
    left: 10px;
    right: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    pointer-events: none;
    user-select: none;
  }

  .reg-bar-top {
    top: 10px;
    color: var(--accent-terracotta);
    font-weight: 500;
  }

  .reg-dim {
    background-color: var(--bg-surface);
    color: var(--text-primary);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }

  .reg-bar-bottom {
    bottom: 10px;
    color: var(--text-primary);
    background-color: var(--bg-surface);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }

  .reg-coord {
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }

  .reg-status {
    color: var(--accent-terracotta);
    font-weight: 600;
    font-size: 0.6rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .schematic-layer,
    .profile-frame,
    .reg-reticle {
      transition: none !important;
    }
  }

  /* Pending placeholder styling */
  .profile-frame-pending {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px dashed var(--border-active);
    background-color: var(--bg-surface);
  }

  .pending-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
    padding: var(--space-6);
  }

  .pending-badge {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .pending-path {
    font-size: 0.7rem;
    color: var(--text-secondary);
    background: var(--bg-canvas);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }

  .pending-note {
    font-size: 0.7rem;
    color: var(--text-muted);
  }
</style>
