---
import type { ProjectItem } from '../types';

interface Props {
  project: ProjectItem;
  index: number;
}

const { project, index } = Astro.props;

const domainLabels: Record<string, string> = {
  data: 'Data Engineering',
  software: 'Software Engineering',
  ai: 'Applied ML & Analytics',
};

const domainName = domainLabels[project.domain] || project.domain;

function getMaturity(id: string, status?: string): { label: string; pillClass: string } {
  if (id === 'topic-modeling-researcher-recommendation') {
    return { label: 'Research thesis', pillClass: 'pill-thesis' };
  }
  if (id === 'research-collaboration-analyzer') {
    return { label: 'Private case study', pillClass: 'pill-private' };
  }
  if (status === 'planned' || id === 'data-pipeline') {
    return { label: 'Planned specification', pillClass: 'pill-planned' };
  }
  return { label: 'Completed project', pillClass: 'pill-completed' };
}

const maturity = getMaturity(project.id, project.status);
const indexStr = String(index).padStart(2, '0');
const hasYear = project.year && project.year !== 'Planned';
---

<article class="project-row" data-domain={project.domain} aria-labelledby={`proj-title-${project.id}`}>
  <div class="row-meta font-mono text-xs text-muted">
    <div class="meta-top">
      <span class="row-index text-primary font-mono">{indexStr}</span>
      {hasYear && (
        <>
          <span class="meta-sep" aria-hidden="true">/</span>
          <span class="row-year font-mono">{project.year}</span>
        </>
      )}
    </div>

    <span class="row-domain text-secondary font-mono">{domainName}</span>

    <span class:list={['maturity-pill', 'font-mono', maturity.pillClass]}>
      {maturity.label}
    </span>
  </div>

  <div class="row-content">
    <h3 id={`proj-title-${project.id}`} class="project-title font-serif">
      {project.title}
    </h3>

    <p class="project-summary text-secondary text-sm">
      {project.summary}
    </p>

    <div class="tech-stack" aria-label={`Technologies used in ${project.title}`}>
      {project.technologies.map((tech) => (
        <span class="tech-chip font-mono text-xs">{tech}</span>
      ))}
    </div>

    <div class="row-links">
      {project.githubUrl ? (
        <a
          href={project.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="project-link font-mono text-xs"
          aria-label={`View code repository for ${project.title}`}
        >
          <span>Repository</span>
          <span class="link-glyph" aria-hidden="true">↗</span>
        </a>
      ) : project.id === 'data-pipeline' ? (
        <span class="project-note font-mono text-xs text-muted">
          Architecture specification
        </span>
      ) : (
        <span class="project-note font-mono text-xs text-muted">
          Case study (private code)
        </span>
      )}

      {project.liveUrl && (
        <a
          href={project.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="project-link font-mono text-xs"
          aria-label={`View demonstration for ${project.title}`}
        >
          <span>Demo</span>
          <span class="link-glyph" aria-hidden="true">↗</span>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .project-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    padding: var(--space-8) 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .project-row:first-child {
    padding-top: var(--space-2);
  }

  .project-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  @media (min-width: 680px) {
    .project-row {
      grid-template-columns: 210px 1fr;
      gap: var(--space-6);
    }
  }

  .row-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    line-height: 1.4;
  }

  .meta-top {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    font-size: var(--text-sm);
  }

  .row-index {
    font-weight: 600;
  }

  .meta-sep {
    opacity: 0.4;
  }

  .row-year {
    color: var(--text-secondary);
  }

  .row-domain {
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
  }

  .maturity-pill {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    font-size: 0.7rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    background-color: var(--bg-surface);
    color: var(--text-secondary);
    line-height: 1.3;
    letter-spacing: 0.02em;
    margin-top: 0.25rem;
  }

  .pill-completed {
    border-color: var(--border-active);
    color: var(--text-primary);
  }

  .pill-thesis {
    border-color: var(--border-active);
    color: var(--text-primary);
  }

  .pill-private {
    color: var(--text-muted);
  }

  .pill-planned {
    border-style: dashed;
    color: var(--text-muted);
  }

  .row-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }

  .project-title {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
    letter-spacing: -0.015em;
    margin: 0;
  }

  .project-summary {
    line-height: 1.6;
    margin: 0;
  }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: 0.1rem;
  }

  .tech-chip {
    padding: 0.2rem 0.5rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: 0.75rem;
    line-height: 1.3;
  }

  .row-links {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: var(--accent-terracotta);
    text-underline-offset: 3px;
    transition: color var(--transition-fast), text-decoration-color var(--transition-fast);
  }

  .project-link:hover {
    color: var(--accent-terracotta);
  }

  .project-link:focus-visible {
    outline: 2px solid var(--accent-terracotta);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .link-glyph {
    text-decoration: none;
  }

  .project-note {
    font-style: normal;
  }
</style>
