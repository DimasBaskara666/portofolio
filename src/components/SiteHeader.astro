---
import { profile } from '../data/profile';

interface Props {
  brandName?: string;
  statusText?: string;
  githubUrl?: string;
  linkedinUrl?: string;
}

const {
  brandName = "sys.dev",
  statusText = "Available for roles",
  githubUrl = profile.githubUrl,
  linkedinUrl = profile.linkedinUrl,
} = Astro.props;

function isPlaceholderOrEmpty(url: string | undefined, platform: 'github' | 'linkedin'): boolean {
  if (!url || typeof url !== 'string') return true;
  const trimmed = url.trim();
  if (!trimmed) return true;

  try {
    const parsed = new URL(trimmed);
    const hostname = parsed.hostname.toLowerCase().replace(/^www\./, '');
    const pathname = parsed.pathname.replace(/\/+$/, '');

    if (platform === 'github') {
      if (hostname !== 'github.com') return true;
      return pathname.length === 0;
    }

    if (platform === 'linkedin') {
      if (hostname !== 'linkedin.com') return true;
      return pathname.length === 0;
    }
  } catch {
    return true;
  }

  return true;
}

const showGithub = Boolean(githubUrl && !isPlaceholderOrEmpty(githubUrl, 'github'));
const showLinkedin = Boolean(linkedinUrl && !isPlaceholderOrEmpty(linkedinUrl, 'linkedin'));
const hasSocialLinks = showGithub || showLinkedin;
---

<header class="site-header">
  <div class="container header-inner">
    <div class="header-left">
      <a href="/" class="brand-link" aria-label="Home">
        <span class="operator-glyph font-mono" aria-hidden="true">//</span>
        <span class="brand-text font-mono">{brandName}</span>
      </a>

      <div class="status-pill" role="status" aria-label={`Status: ${statusText}`}>
        <span class="status-dot" aria-hidden="true"></span>
        <span class="status-label font-mono">{statusText}</span>
      </div>
    </div>

    <nav class="header-nav" aria-label="Main Navigation">
      <ul class="nav-links">
        <li><a href="/#work" class="nav-link font-mono">Work</a></li>
        <li><a href="/#competencies" class="nav-link font-mono">Skills</a></li>
        <li><a href="/#logs" class="nav-link font-mono">Logs</a></li>
        <li><a href="/#contact" class="nav-link font-mono">Contact</a></li>
      </ul>

      {hasSocialLinks && (
        <>
          <div class="header-divider" aria-hidden="true"></div>

          <div class="social-links">
            {showGithub && (
              <a
                href={githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="social-link"
                aria-label="GitHub Profile"
              >
                <svg
                  class="social-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                  <path d="M9 18c-4.51 2-5-2-7-2"></path>
                </svg>
              </a>
            )}

            {showLinkedin && (
              <a
                href={linkedinUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="social-link"
                aria-label="LinkedIn Profile"
              >
                <svg
                  class="social-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                  <rect x="2" y="9" width="4" height="12"></rect>
                  <circle cx="4" cy="4" r="2"></circle>
                </svg>
              </a>
            )}
          </div>
        </>
      )}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background-color: rgba(9, 9, 11, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-subtle);
    transition: border-color var(--transition-fast);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.75rem;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .brand-link:hover {
    color: var(--text-accent);
  }

  .brand-link:focus-visible {
    outline: 2px solid var(--text-accent);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  .operator-glyph {
    color: var(--text-accent);
    font-weight: 600;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.2rem 0.55rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    transition: border-color var(--transition-fast);
  }

  .status-pill:hover {
    border-color: var(--border-active);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-emerald);
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.6);
  }

  .status-label {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    letter-spacing: 0.02em;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .nav-link {
    display: inline-block;
    padding: var(--space-1) var(--space-2);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    border-radius: var(--radius-sm);
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--text-primary);
    background-color: var(--bg-surface-hover);
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--text-accent);
    outline-offset: 2px;
  }

  .header-divider {
    width: 1px;
    height: 1rem;
    background-color: var(--border-subtle);
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.875rem;
    height: 1.875rem;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .social-link:hover {
    color: var(--text-primary);
    background-color: var(--bg-surface-hover);
  }

  .social-link:focus-visible {
    outline: 2px solid var(--text-accent);
    outline-offset: 2px;
  }

  .social-icon {
    width: 1rem;
    height: 1rem;
  }

  @media (max-width: 600px) {
    .header-inner {
      min-height: auto;
      padding-top: var(--space-3);
      padding-bottom: var(--space-3);
      gap: var(--space-2);
    }

    .header-left {
      width: 100%;
      justify-content: space-between;
    }

    .header-nav {
      width: 100%;
      justify-content: space-between;
      border-top: 1px solid var(--border-subtle);
      padding-top: var(--space-2);
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    .nav-links {
      flex-wrap: wrap;
      gap: var(--space-1);
    }
  }
</style>
