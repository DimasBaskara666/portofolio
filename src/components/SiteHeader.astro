---
import { profile } from '../data/profile';

interface Props {
  brandName?: string;
  githubUrl?: string;
  linkedinUrl?: string;
  activeNav?: 'work' | 'about';
}

const {
  brandName = "Dimas",
  githubUrl = profile.githubUrl,
  linkedinUrl = profile.linkedinUrl,
  activeNav,
} = Astro.props;

function isPlaceholderOrEmpty(url: string | undefined, platform: 'github' | 'linkedin'): boolean {
  if (!url || typeof url !== 'string') return true;
  const trimmed = url.trim();
  if (!trimmed) return true;

  try {
    const parsed = new URL(trimmed);
    const hostname = parsed.hostname.toLowerCase().replace(/^www\./, '');
    const pathname = parsed.pathname.replace(/\/+$/, '');

    if (platform === 'github') {
      if (hostname !== 'github.com') return true;
      return pathname.length === 0;
    }

    if (platform === 'linkedin') {
      if (hostname !== 'linkedin.com') return true;
      return pathname.length === 0;
    }
  } catch {
    return true;
  }

  return true;
}

const showGithub = Boolean(githubUrl && !isPlaceholderOrEmpty(githubUrl, 'github'));
const showLinkedin = Boolean(linkedinUrl && !isPlaceholderOrEmpty(linkedinUrl, 'linkedin'));
const hasSocialLinks = showGithub || showLinkedin;

// Determine route-aware active states
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isAbout = activeNav === 'about' || currentPath === '/about' || currentPath.startsWith('/about/');
const isWork = activeNav === 'work' || (!isAbout && (currentPath === '/' || currentPath.startsWith('/#')));
---

<header class="site-header">
  <div class="container header-inner">
    <div class="header-left">
      <a href="/" class="brand-link" aria-label="Dimas - Home">
        <span class="brand-logo-frame" aria-hidden="true">
          <img
            src="/images/logo-light.svg"
            alt=""
            width="24"
            height="24"
            class="brand-logo logo-for-dark"
            loading="eager"
            decoding="async"
          />
          <img
            src="/images/logo-dark.svg"
            alt=""
            width="24"
            height="24"
            class="brand-logo logo-for-light"
            loading="eager"
            decoding="async"
          />
        </span>
        <span class="brand-text font-serif">{brandName}</span>
      </a>
    </div>

    <nav class="header-nav" aria-label="Main Navigation">
      <ul class="nav-links">
        <li>
          <a
            href="/"
            class:list={['nav-link', 'font-mono', { active: isWork }]}
            aria-current={isWork ? 'page' : undefined}
          >
            Work
          </a>
        </li>
        <li>
          <a
            href="/about/"
            class:list={['nav-link', 'font-mono', { active: isAbout }]}
            aria-current={isAbout ? 'page' : undefined}
          >
            About
          </a>
        </li>
      </ul>

      {hasSocialLinks && (
        <>
          <div class="header-divider" aria-hidden="true"></div>

          <div class="social-links">
            {showGithub && (
              <a
                href={githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="social-link"
                aria-label="GitHub Profile"
              >
                <svg
                  class="social-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                  <path d="M9 18c-4.51 2-5-2-7-2"></path>
                </svg>
              </a>
            )}

            {showLinkedin && (
              <a
                href={linkedinUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="social-link"
                aria-label="LinkedIn Profile"
              >
                <svg
                  class="social-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                  <rect x="2" y="9" width="4" height="12"></rect>
                  <circle cx="4" cy="4" r="2"></circle>
                </svg>
              </a>
            )}
          </div>
        </>
      )}

      <div class="header-divider theme-divider" aria-hidden="true"></div>

      <button
        type="button"
        id="theme-toggle"
        class="theme-toggle"
        aria-label="Switch to light theme"
        title="Switch to light theme"
      >
        <svg
          class="theme-icon icon-sun"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg
          class="theme-icon icon-moon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background-color: var(--header-bg, rgba(24, 23, 22, 0.88));
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-subtle);
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.75rem;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .brand-link:hover {
    color: var(--accent-terracotta);
  }

  .brand-link:focus-visible {
    outline: 2px solid var(--accent-terracotta);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  .brand-logo-frame {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .brand-logo {
    width: 24px;
    height: 24px;
    object-fit: contain;
    display: block;
  }

  :global(:root) .brand-logo.logo-for-dark,
  :global(:root[data-theme="dark"]) .brand-logo.logo-for-dark {
    display: block;
  }
  :global(:root) .brand-logo.logo-for-light,
  :global(:root[data-theme="dark"]) .brand-logo.logo-for-light {
    display: none;
  }

  :global(:root[data-theme="light"]) .brand-logo.logo-for-dark {
    display: none;
  }
  :global(:root[data-theme="light"]) .brand-logo.logo-for-light {
    display: block;
  }

  .brand-text {
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .nav-link {
    display: inline-block;
    padding: 0.35rem 0.65rem;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
    border-radius: var(--radius-sm);
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--text-primary);
    background-color: var(--bg-surface);
  }

  .nav-link.active {
    color: var(--text-primary);
    background-color: var(--bg-surface);
    font-weight: 600;
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--accent-terracotta);
    outline-offset: 2px;
  }

  .header-divider {
    width: 1px;
    height: 1rem;
    background-color: var(--border-subtle);
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .social-link:hover {
    color: var(--text-primary);
    background-color: var(--bg-surface);
  }

  .social-link:focus-visible {
    outline: 2px solid var(--accent-terracotta);
    outline-offset: 2px;
  }

  .social-icon {
    width: 1.05rem;
    height: 1.05rem;
  }

  /* Theme toggle button */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
    transition: color var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .theme-toggle:hover {
    color: var(--text-primary);
    background-color: var(--bg-surface);
    border-color: var(--border-subtle);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent-terracotta);
    outline-offset: 2px;
  }

  .theme-icon {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* In dark mode (default), show sun to switch to light */
  :global(:root) .icon-sun,
  :global(:root[data-theme="dark"]) .icon-sun {
    display: block;
  }
  :global(:root) .icon-moon,
  :global(:root[data-theme="dark"]) .icon-moon {
    display: none;
  }

  /* In light mode, show moon to switch to dark */
  :global(:root[data-theme="light"]) .icon-sun {
    display: none;
  }
  :global(:root[data-theme="light"]) .icon-moon {
    display: block;
  }

  @media (max-width: 640px) {
    .header-inner {
      min-height: 3.5rem;
      padding-top: var(--space-2);
      padding-bottom: var(--space-2);
      gap: var(--space-2);
      flex-wrap: nowrap;
    }

    .header-left {
      flex-shrink: 0;
    }

    .header-divider,
    .social-links {
      display: none;
    }

    .header-nav {
      gap: var(--space-1);
    }

    .nav-links {
      gap: var(--space-1);
    }

    .nav-link {
      padding: var(--space-1) var(--space-2);
      font-size: var(--text-xs);
      letter-spacing: 0.05em;
    }
  }
</style>

<script>
  function setupThemeToggle(): void {
    const toggleBtn = document.getElementById('theme-toggle');
    if (!toggleBtn) return;

    function syncState(): void {
      const current = document.documentElement.dataset.theme || 'dark';
      const isDark = current === 'dark';
      const label = isDark ? 'Switch to light theme' : 'Switch to dark theme';
      toggleBtn?.setAttribute('aria-label', label);
      toggleBtn?.setAttribute('title', label);
    }

    syncState();

    if (toggleBtn.dataset.bound === 'true') return;
    toggleBtn.dataset.bound = 'true';

    toggleBtn.addEventListener('click', () => {
      const active = document.documentElement.dataset.theme || 'dark';
      const next = active === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
      syncState();

      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) {
        meta.setAttribute('content', next === 'dark' ? '#181716' : '#f7f5f0');
      }
    });
  }

  document.addEventListener('astro:page-load', setupThemeToggle);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupThemeToggle);
  } else {
    setupThemeToggle();
  }
</script>
