---
import { getCollection } from 'astro:content';

const allLogs = await getCollection('logs');

// Sort by publishDate descending
const sortedLogs = allLogs.sort((a, b) => {
  return new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime();
});
---

<div class="engineering-logs" role="region" aria-label="Engineering Logs and Case Studies">
  {sortedLogs.length === 0 ? (
    <div class="logs-empty font-mono text-sm text-muted">
      No engineering logs published yet.
    </div>
  ) : (
    <div class="logs-list">
      {sortedLogs.map((log) => (
        <article class="log-card" aria-labelledby={`log-title-${log.id}`}>
          <header class="log-card-header">
            <div class="log-meta font-mono text-xs">
              <span class="log-category text-accent">
                <span class="category-glyph" aria-hidden="true">//</span>
                {log.data.category}
              </span>
              <span class="meta-delimiter text-muted" aria-hidden="true">·</span>
              <time datetime={log.data.publishDate} class="log-date text-muted">
                {log.data.publishDate}
              </time>
              {log.data.readTime && (
                <>
                  <span class="meta-delimiter text-muted" aria-hidden="true">·</span>
                  <span class="log-readtime text-muted">{log.data.readTime}</span>
                </>
              )}
            </div>

            <h3 id={`log-title-${log.id}`} class="log-title">
              <a href={`/logs/${log.id}`} class="log-title-link">
                {log.data.title}
              </a>
            </h3>
          </header>

          <p class="log-description text-secondary text-sm">
            {log.data.description}
          </p>

          <div class="log-tags" aria-label="Article tags">
            {log.data.tags.map((tag) => (
              <span class="tag-chip font-mono text-xs">{tag}</span>
            ))}
          </div>

          <footer class="log-card-footer">
            <a
              href={`/logs/${log.id}`}
              class="read-more-link font-mono text-xs text-accent"
              aria-label={`Read complete article: ${log.data.title}`}
            >
              <span>Read Full Article</span>
              <span class="arrow-glyph" aria-hidden="true">→</span>
            </a>
          </footer>
        </article>
      ))}
    </div>
  )}
</div>

<style>
  .engineering-logs {
    width: 100%;
  }

  .logs-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .log-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .log-card:hover {
    border-color: var(--border-active);
    background-color: var(--bg-surface-hover);
  }

  .log-card-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .log-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    letter-spacing: 0.04em;
  }

  .category-glyph {
    opacity: 0.8;
    margin-right: 0.15rem;
  }

  .log-title {
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.35;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .log-title-link {
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .log-title-link:hover {
    color: var(--text-accent);
  }

  .log-description {
    line-height: 1.55;
    margin: 0;
  }

  .log-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: 0.1rem;
  }

  .tag-chip {
    padding: 0.15rem 0.45rem;
    background-color: var(--bg-canvas);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 0.7rem;
  }

  .log-card-footer {
    display: flex;
    align-items: center;
    padding-top: var(--space-2);
    margin-top: auto;
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color var(--transition-fast);
  }

  .read-more-link:hover {
    color: var(--text-primary);
  }

  .logs-empty {
    padding: var(--space-6);
    background-color: var(--bg-surface);
    border: 1px dashed var(--border-subtle);
    border-radius: var(--radius-md);
  }
</style>
