---
import type { ArchitectureStep } from '../types';

interface Props {
  steps: ArchitectureStep[];
  projectName?: string;
}

const { steps, projectName = "System" } = Astro.props;
---

<div class="architecture-flow" role="region" aria-label={`${projectName} Architecture Flow`}>
  <div class="sr-only">
    Sequential data flow:
    {steps.map((s) => `Step ${s.step}: ${s.label} (${s.description})`).join(' -> ')}
  </div>

  <div class="diagram-scroll-container">
    <div class="diagram-fade diagram-fade-left" aria-hidden="true"></div>
    <div class="diagram-fade diagram-fade-right" aria-hidden="true"></div>

    <ol
      class="diagram-steps"
      tabindex="0"
      aria-label={`${projectName} workflow steps, use arrow keys to scroll horizontally`}
    >
      {steps.map((step, idx) => (
        <li class="diagram-step-item" aria-hidden="true">
          <div class="step-card">
            <div class="step-top font-mono text-xs">
              <span class="step-number">0{step.step}</span>
              {step.tag && <span class="step-tag">{step.tag}</span>}
            </div>
            <div class="step-label font-mono">{step.label}</div>
            <p class="step-desc text-secondary text-xs">{step.description}</p>
          </div>
          {idx < steps.length - 1 && (
            <div class="step-connector">
              <span class="connector-line"></span>
              <span class="connector-arrow">→</span>
            </div>
          )}
        </li>
      ))}
    </ol>
  </div>

  <div class="diagram-hint font-mono text-xs text-muted" aria-hidden="true">
    <span class="hint-glyph">↔</span>
    <span>Scroll horizontally to inspect full workflow</span>
  </div>
</div>

<script>
  function initDiagramOverflow(): void {
    const flows = document.querySelectorAll<HTMLElement>('.architecture-flow');

    flows.forEach((flow) => {
      const scroller = flow.querySelector<HTMLElement>('.diagram-steps');
      if (!scroller) return;

      const updateOverflow = (): void => {
        if (scroller.clientWidth === 0) return;

        const hasOverflow = scroller.scrollWidth > scroller.clientWidth + 2;
        const isAtStart = scroller.scrollLeft <= 2;
        const isAtEnd = scroller.scrollLeft + scroller.clientWidth >= scroller.scrollWidth - 2;

        flow.classList.toggle('has-overflow', hasOverflow);
        flow.classList.toggle('can-scroll-left', hasOverflow && !isAtStart);
        flow.classList.toggle('can-scroll-right', hasOverflow && !isAtEnd);
      };

      scroller.addEventListener('scroll', updateOverflow, { passive: true });

      if (typeof ResizeObserver !== 'undefined') {
        const ro = new ResizeObserver(updateOverflow);
        ro.observe(scroller);
      } else {
        window.addEventListener('resize', updateOverflow, { passive: true });
      }

      const details = flow.closest('details');
      if (details) {
        details.addEventListener('toggle', () => {
          if (details.open) {
            requestAnimationFrame(updateOverflow);
          }
        });
      }

      updateOverflow();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDiagramOverflow);
  } else {
    initDiagramOverflow();
  }
</script>

<style>
  .architecture-flow {
    width: 100%;
    margin-top: var(--space-4);
    padding: var(--space-4);
    background-color: var(--bg-canvas);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
  }

  .diagram-scroll-container {
    position: relative;
    width: 100%;
  }

  .diagram-fade {
    display: none;
    position: absolute;
    top: 0;
    bottom: var(--space-2);
    width: 2.5rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--transition-fast);
    z-index: 2;
  }

  .diagram-fade-left {
    left: 0;
    background: linear-gradient(to right, var(--bg-canvas), transparent);
  }

  .diagram-fade-right {
    right: 0;
    background: linear-gradient(to left, var(--bg-canvas), transparent);
  }

  .architecture-flow.can-scroll-left .diagram-fade-left {
    opacity: 1;
  }

  .architecture-flow.can-scroll-right .diagram-fade-right {
    opacity: 1;
  }

  .diagram-steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .diagram-steps:focus-visible {
    outline: 2px solid var(--text-accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  @media (min-width: 768px) {
    .diagram-fade {
      display: block;
    }

    .diagram-steps {
      flex-direction: row;
      align-items: stretch;
      gap: 0;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      padding-bottom: var(--space-2);
      scrollbar-width: thin;
      scrollbar-color: var(--border-active) transparent;
    }

    .diagram-steps::-webkit-scrollbar {
      height: 4px;
    }

    .diagram-steps::-webkit-scrollbar-track {
      background: transparent;
    }

    .diagram-steps::-webkit-scrollbar-thumb {
      background-color: var(--border-subtle);
      border-radius: var(--radius-full);
    }

    .diagram-steps::-webkit-scrollbar-thumb:hover {
      background-color: var(--border-active);
    }
  }

  .diagram-step-item {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    width: 100%;
  }

  @media (min-width: 768px) {
    .diagram-step-item {
      flex-direction: row;
      align-items: center;
      min-width: 12rem;
      width: auto;
    }
  }

  .step-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
    width: 100%;
    height: 100%;
    transition: border-color var(--transition-fast);
  }

  .step-card:hover {
    border-color: var(--border-active);
  }

  .step-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.15rem;
  }

  .step-number {
    color: var(--text-muted);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
  }

  .step-tag {
    color: var(--text-accent);
    background-color: rgba(56, 189, 248, 0.08);
    padding: 0.1rem 0.35rem;
    border-radius: var(--radius-sm);
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .step-label {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.35;
  }

  .step-desc {
    line-height: 1.4;
    margin-top: 0.2rem;
  }

  .step-connector {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--border-active);
    padding: var(--space-1) 0;
    flex-shrink: 0;
  }

  .connector-arrow {
    display: block;
    transform: rotate(90deg);
    font-size: var(--text-sm);
  }

  .connector-line {
    display: none;
  }

  @media (min-width: 768px) {
    .step-connector {
      padding: 0 var(--space-2);
    }

    .connector-arrow {
      transform: none;
    }
  }

  .diagram-hint {
    display: none;
    align-items: center;
    gap: var(--space-1);
    margin-top: var(--space-2);
    font-size: 0.7rem;
    color: var(--text-muted);
    letter-spacing: 0.03em;
  }

  .hint-glyph {
    color: var(--text-accent);
  }

  .architecture-flow.has-overflow .diagram-hint {
    display: flex;
  }

  @media (max-width: 767px) {
    .architecture-flow.has-overflow .diagram-hint {
      display: none !important;
    }

    .diagram-fade {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .diagram-fade {
      transition: none !important;
    }
  }
</style>
