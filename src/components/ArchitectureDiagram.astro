---
import type { ArchitectureStep } from '../types';

interface Props {
  steps: ArchitectureStep[];
  projectName?: string;
}

const { steps, projectName = "System" } = Astro.props;
---

<div class="architecture-flow" role="region" aria-label={`${projectName} Architecture Flow`}>
  <div class="sr-only">
    Sequential data flow:
    {steps.map((s) => `Step ${s.step}: ${s.label} (${s.description})`).join(' -> ')}
  </div>

  <ol class="diagram-steps" aria-hidden="true">
    {steps.map((step, idx) => (
      <li class="diagram-step-item">
        <div class="step-card">
          <div class="step-top font-mono text-xs">
            <span class="step-number">0{step.step}</span>
            {step.tag && <span class="step-tag">{step.tag}</span>}
          </div>
          <div class="step-label font-mono">{step.label}</div>
          <p class="step-desc text-secondary text-xs">{step.description}</p>
        </div>
        {idx < steps.length - 1 && (
          <div class="step-connector">
            <span class="connector-line"></span>
            <span class="connector-arrow">→</span>
          </div>
        )}
      </li>
    ))}
  </ol>
</div>

<style>
  .architecture-flow {
    width: 100%;
    margin-top: var(--space-4);
    padding: var(--space-4);
    background-color: var(--bg-canvas);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
  }

  .diagram-steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
  }

  @media (min-width: 768px) {
    .diagram-steps {
      flex-direction: row;
      align-items: stretch;
      gap: 0;
      overflow-x: auto;
      padding-bottom: var(--space-2);
    }
  }

  .diagram-step-item {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 12rem;
  }

  @media (min-width: 768px) {
    .diagram-step-item {
      flex-direction: row;
      align-items: center;
    }
  }

  .step-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
    width: 100%;
    height: 100%;
    transition: border-color var(--transition-fast);
  }

  .step-card:hover {
    border-color: var(--border-active);
  }

  .step-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.15rem;
  }

  .step-number {
    color: var(--text-muted);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
  }

  .step-tag {
    color: var(--text-accent);
    background-color: rgba(56, 189, 248, 0.08);
    padding: 0.1rem 0.35rem;
    border-radius: var(--radius-sm);
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .step-label {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.35;
  }

  .step-desc {
    line-height: 1.4;
    margin-top: 0.2rem;
  }

  .step-connector {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--border-active);
    padding: var(--space-1) 0;
    flex-shrink: 0;
  }

  .connector-arrow {
    display: block;
    transform: rotate(90deg);
    font-size: var(--text-sm);
  }

  .connector-line {
    display: none;
  }

  @media (min-width: 768px) {
    .step-connector {
      padding: 0 var(--space-2);
    }

    .connector-arrow {
      transform: none;
    }
  }
</style>
