---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile } from '../data/profile';

const allProjects = await getCollection('projects');

// Prioritize lead data engineering, thesis NLP research, desktop case study, then planned pipeline
const projectOrder = [
  'mecut-radar',
  'topic-modeling-researcher-recommendation',
  'research-collaboration-analyzer',
  'data-pipeline',
];

const sortedProjects = [...allProjects].sort((a, b) => {
  const indexA = projectOrder.indexOf(a.id);
  const indexB = projectOrder.indexOf(b.id);
  return (indexA === -1 ? 999 : indexA) - (indexB === -1 ? 999 : indexB);
});

const projects = sortedProjects.map((entry) => ({
  id: entry.id,
  title: entry.data.title,
  domain: entry.data.domain,
  year: entry.data.year,
  summary: entry.data.summary,
  technicalContext: entry.data.technicalContext,
  status: entry.data.status,
  metrics: entry.data.metrics,
  technologies: entry.data.technologies,
  githubUrl: entry.data.githubUrl,
  liveUrl: entry.data.liveUrl,
  architectureSteps: entry.data.architectureSteps,
  featured: entry.data.featured,
}));
---

<BaseLayout
  title="Dimas | Data Engineer"
  description="Personal portfolio of Dimas, an Informatics graduate specializing in Data Engineering, reproducible data processing pipelines, and applied analytics."
  brandName="Dimas"
  githubUrl={profile.githubUrl}
  linkedinUrl={profile.linkedinUrl}
  emailAddress={profile.email}
  currentFocus="Reproducible data pipelines & automated batch processing"
  pageType="profile"
  activeNav="work"
>
  <div class="container page-content">
    <!-- Hero Section -->
    <Hero
      name={profile.name}
      cvUrl={profile.cvUrl}
    />

    <!-- Selected Projects Section -->
    <section id="work" class="section-block" aria-labelledby="work-heading">
      <div class="section-header">
        <h2 id="work-heading" class="section-title font-serif">
          Selected systems and architecture
        </h2>
        <span class="section-count font-mono text-xs text-muted">
          {projects.length} systems
        </span>
      </div>

      <div class="projects-list" id="projects-list">
        {projects.map((project, idx) => (
          <ProjectCard project={project} index={idx + 1} />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-content {
    padding-top: var(--space-4);
    padding-bottom: var(--space-16);
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  @media (min-width: 640px) {
    .page-content {
      padding-top: var(--space-6);
      gap: var(--space-12);
    }
  }

  .section-block {
    scroll-margin-top: 5rem;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 0;
  }

  .section-title {
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.25;
    letter-spacing: -0.015em;
    margin: 0;
  }

  .section-count {
    letter-spacing: 0.04em;
  }

  .projects-list {
    display: flex;
    flex-direction: column;
  }
</style>
