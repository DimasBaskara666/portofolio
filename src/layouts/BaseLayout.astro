---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import TelemetryFooter from '../components/TelemetryFooter.astro';
import SEO from '../components/SEO.astro';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  brandName?: string;
  statusText?: string;
  githubUrl?: string;
  linkedinUrl?: string;
  emailAddress?: string;
  currentFocus?: string;
  pageType?: 'website' | 'article' | 'profile';
  ogImage?: string;
  publishedTime?: string;
  tags?: string[];
  activeNav?: 'work' | 'about';
}

const {
  title = "Dimas | Data Engineer",
  description = "Personal portfolio of Dimas, an Informatics graduate specializing in Data Engineering, reproducible data processing pipelines, and applied analytics.",
  canonicalUrl,
  brandName = "Dimas",
  statusText = "Available for roles",
  githubUrl = profile.githubUrl,
  linkedinUrl = profile.linkedinUrl,
  emailAddress = profile.email,
  currentFocus = "Reproducible data pipelines & automated batch processing",
  pageType = "website",
  ogImage,
  publishedTime,
  tags,
  activeNav,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#181716" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline>
      (function () {
        function applyStoredTheme() {
          try {
            var stored = localStorage.getItem('theme');
            var theme = (stored === 'light' || stored === 'dark') ? stored : 'dark';
            document.documentElement.dataset.theme = theme;
            var metaTheme = document.querySelector('meta[name="theme-color"]');
            if (metaTheme) {
              metaTheme.setAttribute('content', theme === 'dark' ? '#181716' : '#f7f5f0');
            }
          } catch (e) {
            document.documentElement.dataset.theme = 'dark';
          }
        }
        applyStoredTheme();
        document.addEventListener('astro:after-swap', applyStoredTheme);
      })();
    </script>
    <ClientRouter fallback="animate" />

    <!-- SEO & Metadata -->
    <SEO
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      pageType={pageType}
      ogImage={ogImage}
      publishedTime={publishedTime}
      tags={tags}
    />
  </head>
  <body>
    <a href="#main-content" class="skip-link font-mono">
      Skip to main content
    </a>

    <SiteHeader
      brandName={brandName}
      statusText={statusText}
      githubUrl={githubUrl}
      linkedinUrl={linkedinUrl}
      activeNav={activeNav}
    />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <TelemetryFooter currentFocus={currentFocus} emailAddress={emailAddress} />
  </body>
</html>

<style>
  #main-content {
    min-height: 70vh;
    outline: none;
    width: 100%;
    min-width: 0;
  }
</style>
